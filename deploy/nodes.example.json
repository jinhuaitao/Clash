{
  "_说明": "把 nodes 里的 5 个示例替换成你自己的节点信息，保存为 nodes.json 后执行：transit-hub import-nodes /etc/transit-hub/nodes.json。以下均为占位值，不可直接使用。",
  "_字段提示": "必填 name/type/server/port；vless+vmess 需 uuid；trojan+hysteria2+ss 需 password；vless 开 reality 时必须给 publicKey；groupId 可用 us/jp/hk/relay 或留空表示未分组。",
  "_上限": "最多 300 个节点，节点名不能重复，不能与策略组同名。",
  "nodes": [
    {
      "name": "示例-VLESS-Reality-香港01",
      "type": "vless",
      "server": "hk01.example.com",
      "port": 443,
      "groupId": "hk",
      "uuid": "b831381d-6324-4d53-ad4f-8cda48b30811",
      "network": "tcp",
      "tls": true,
      "reality": true,
      "servername": "www.microsoft.com",
      "publicKey": "REPLACE_WITH_YOUR_REALITY_PUBLIC_KEY",
      "shortId": "",
      "flow": "xtls-rprx-vision",
      "fingerprint": "chrome",
      "udp": true,
      "enabled": true
    },
    {
      "name": "示例-Hysteria2-日本01",
      "type": "hysteria2",
      "server": "jp01.example.com",
      "port": 443,
      "groupId": "jp",
      "password": "REPLACE_WITH_YOUR_PASSWORD",
      "sni": "jp01.example.com",
      "up": "100 mbps",
      "down": "500 mbps",
      "skipCertVerify": false,
      "enabled": true
    },
    {
      "name": "示例-Trojan-美国01",
      "type": "trojan",
      "server": "us01.example.com",
      "port": 443,
      "groupId": "us",
      "password": "REPLACE_WITH_YOUR_PASSWORD",
      "sni": "us01.example.com",
      "udp": true,
      "skipCertVerify": false,
      "enabled": true
    },
    {
      "name": "示例-VMess-WS-中转01",
      "type": "vmess",
      "server": "relay01.example.com",
      "port": 443,
      "groupId": "relay",
      "uuid": "b831381d-6324-4d53-ad4f-8cda48b30811",
      "network": "ws",
      "tls": true,
      "wsPath": "/ws",
      "wsHost": "relay01.example.com",
      "servername": "relay01.example.com",
      "udp": true,
      "enabled": true
    },
    {
      "name": "示例-Shadowsocks-新加坡01",
      "type": "ss",
      "server": "sg01.example.com",
      "port": 8388,
      "groupId": "jp",
      "cipher": "aes-256-gcm",
      "password": "REPLACE_WITH_YOUR_PASSWORD",
      "udp": true,
      "enabled": true
    }
  ]
}
