{
  "name": "transit-hub",
  "version": "2.8.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker：Clash 订阅生成器 + 可视化管理控制台（节点数据全部由 KV 管理，仓库内不含任何节点）",
  "scripts": {
    "check": "node scripts/check.mjs",
    "check:strict": "node scripts/check.mjs --strict",
    "check:selftest": "node scripts/check.mjs --selftest",
    "test": "node scripts/api.test.mjs",
    "build": "node build.mjs",
    "dev": "node build.mjs && wrangler dev",
    "deploy": "node build.mjs && wrangler deploy",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^4"
  },
  "engines": {
    "node": ">=20"
  }
}
